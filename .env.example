# ---------------------------------------------------------------------------
# Training / test subsystem configuration — PLACEHOLDERS ONLY
#
# Copy to `.env` and fill in real values there. `.env` is git-ignored.
# NEVER commit real tokens. NEVER paste tokens into source files.
# If a token is ever committed or pasted into a chat, revoke it immediately
# with /revoke in @BotFather and issue a new one.
# ---------------------------------------------------------------------------

# --- Environment guard -----------------------------------------------------
# Must be exactly "training". Any other value, including "production", must
# cause the subsystem to refuse to start.
TRAINING_ENVIRONMENT=training

# --- Bot tokens (one per logical role; all five must be DISTINCT bots) -----
# Format from @BotFather: <digits>:<35-char base64-ish string>
TRAINING_MANAGER_01_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_MANAGER_02_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_MANAGER_03_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_ADMIN_01_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_LEADER_01_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER

# --- Dedicated test group --------------------------------------------------
# Supergroup IDs are negative and start with -100. This group must contain
# ONLY test participants and the five training bots.
TRAINING_MANAGER_GROUP_ID=-1000000000000

# --- Production denylist (belt and braces over the allowlist) --------------
# Put your PRODUCTION manager group id here. Posting is refused outright if the
# target appears in this list, even if it also appears in the allowlist.
TRAINING_FORBIDDEN_CHAT_IDS=

# --- Production source checkout --------------------------------------------
# Path to a checkout of Alcana-taplink-page. Training claims about production
# behaviour are verified against it; without it those steps report NOT TESTED
# rather than PASS.
ALCANA_SOURCE_PATH=/path/to/Alcana-taplink-page

# --- Chat allowlist --------------------------------------------------------
# Comma-separated chat IDs the subsystem is permitted to touch. Any send to a
# chat outside this list must be refused before the API call is made.
# TRAINING_MANAGER_GROUP_ID must itself appear here.
TRAINING_ALLOWED_CHAT_IDS=-1000000000000
