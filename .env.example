# ---------------------------------------------------------------------------
# Training subsystem configuration — PLACEHOLDERS ONLY
#
# Copy to `.env` and fill in real values there. `.env` is git-ignored.
# NEVER commit real tokens. NEVER paste tokens into source files.
# If a token is ever committed or pasted into a chat, revoke it immediately
# with /revoke in @BotFather and issue a new one.
#
# Read by training/envfile.py — the single configuration mechanism. Values in
# the process environment override this file (TRAINING_* and ALCANA_* only).
# ---------------------------------------------------------------------------

# --- Environment guard (required) ------------------------------------------
# Must be exactly "training". Any other value, including "production", makes
# the bots and the runner refuse to start.
TRAINING_ENVIRONMENT=training

# --- Send guard (required for live use) ------------------------------------
# true  = nothing is transmitted; replies are computed and logged only.
# false = the bots really send messages.
# Anything else, including a typo or an empty value, is treated as true.
# Leave this at true until you have deliberately authorised a live test.
TRAINING_DRY_RUN=true

# --- Manager bot tokens (required; all three must be DISTINCT bots) --------
# Format from @BotFather: <digits>:<35-char string>.
# Manager 1 teaches scenario S1, manager 2 teaches S2, manager 3 teaches S3.
# A token equal to the production TELEGRAM_BOT_TOKEN is refused.
TRAINING_MANAGER_01_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_MANAGER_02_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER
TRAINING_MANAGER_03_BOT_TOKEN=000000000:REPLACE_WITH_TOKEN_FROM_BOTFATHER

# --- Dedicated test group (OPTIONAL) ---------------------------------------
# Leave this blank to train in private chats with each bot — a complete mode
# that needs no group at all.
#
# If you do use a group, it must be a NEW group containing only trainees and
# the training bots. Never put your real manager group's id here: synthetic
# leads carry fake phone numbers, and a real customer's lead could be missed
# among them. The id must also appear in TRAINING_ALLOWED_CHAT_IDS below.
TRAINING_MANAGER_GROUP_ID=

# --- Chat allowlist (only needed if you use a group) -----------------------
# Comma-separated chat ids the subsystem may post to. A group that is not
# listed here is ignored: the bots neither answer nor post in it.
# Private chats with trainees are always allowed — that is where they talk to
# the bot — unless the chat is on the denylist below.
TRAINING_ALLOWED_CHAT_IDS=

# --- Production denylist (strongly recommended) ----------------------------
# Put your PRODUCTION manager group id here. A chat on this list is refused
# outright, even if it also appears in the allowlist. Setting this makes
# posting into the real manager group impossible rather than merely unlikely.
TRAINING_FORBIDDEN_CHAT_IDS=

# --- Long-poll timeout (optional) ------------------------------------------
# Seconds for getUpdates long polling. Clamped to 0..60; default 25.
TRAINING_POLL_TIMEOUT=25

# --- Production source checkout (optional but recommended) -----------------
# Path to a checkout of Alcana-taplink-page. Training claims about production
# behaviour are verified against it; without it those steps report NOT TESTED
# rather than PASS.
ALCANA_SOURCE_PATH=/path/to/Alcana-taplink-page

# ---------------------------------------------------------------------------
# Not set here, but read if present in the environment:
#
#   TELEGRAM_BOT_TOKEN  your PRODUCTION bot token. If any training token
#                       matches it, that bot is refused. Export it in your
#                       shell to get that protection; do not put it in this
#                       file.
# ---------------------------------------------------------------------------
